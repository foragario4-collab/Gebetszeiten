        <TextView android:id="@+id/w4_n2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#FFFFFF" android:shadowColor="#66000000" android:shadowDy="1" android:shadowRadius="3" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w4_t2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="#FFFFFF" android:shadowColor="#66000000" android:shadowDy="1" android:shadowRadius="3" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
