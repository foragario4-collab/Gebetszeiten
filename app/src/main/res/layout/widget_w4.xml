        <TextView android:id="@+id/w4_t3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="#FFFFFF" android:shadowColor="#66000000" android:shadowDy="1" android:shadowRadius="3" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout><LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:layout_marginStart="6dp">
