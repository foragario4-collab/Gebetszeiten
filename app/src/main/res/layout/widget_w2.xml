<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">
<ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no" />
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
    <TextView android:id="@+id/w2_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="#FFFFFF" android:shadowColor="#66000000" android:shadowDy="1" android:shadowRadius="3" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    <Chronometer android:id="@+id/w2_chrono" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="22sp" android:fontFamily="sans-serif-light" android:textColor="#FFFFFF" android:shadowColor="#66000000" android:shadowDy="1" android:shadowRadius="3" android:maxLines="1" />
    <TextView android:id="@+id/w2_at" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#FFFFFF" android:shadowColor="#66000000" android:shadowDy="1" android:shadowRadius="3" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
</FrameLayout>
